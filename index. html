<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gamel - Cooking Academy</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <div class="logo-container">
            <img src="https://images.unsplash.com/photo-1556910103-1c02745aae4d?w=100&auto=format&fit=crop&q=60" alt="Gamel Logo" class="logo-img">
            <h1>Gamel Cooking Academy</h1>
        </div>
        <p>Master African and global dishes step-by-step!</p>
    </header>

    <!-- Search Bar Section -->
    <div class="search-section">
        <input type="text" id="search-input" placeholder="Search a dish (e.g., jollof, banku, rice)...">
        <button onclick="searchRecipe()" class="search-btn">Search Dish</button>
    </div>

    <!-- Container for multiple option buttons if search has many results -->
    <div id="options-container" class="options-container"></div>

    <main>
        <section class="recipe-card">
            <h2 id="recipe-title">Welcome to Gamel</h2>
            <img id="recipe-image" src="https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=600&auto=format&fit=crop&q=80" alt="Cooking Environment" class="recipe-img">
            <p id="recipe-desc" class="description">Search for a favorite dish above or try typing "jollof", "banku", or "rice".</p>

            <h3>Utensils Needed</h3>
            <ul id="utensils-list">
                <li>Cutting board, knife, mixing bowls, cooking pots/pans</li>
            </ul>

            <h3>Ingredients</h3>
            <ul id="ingredients-list">
                <li><em>Select a recipe to view ingredients.</em></li>
            </ul>

            <h3>Step-by-Step Instructions</h3>
            <div id="steps-container">
                <p><em>Your visual cooking steps will appear here.</em></p>
            </div>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
