// Main Search Function handling local database + online public API options
async function searchRecipe() {
    const query = document.getElementById("search-input").value.trim().toLowerCase();
    const optionsContainer = document.getElementById("options-container");
    optionsContainer.innerHTML = ""; // Clear old option buttons

    if (!query) {
        alert("Please enter a dish name to search!");
        return;
    }

    // 1. Check if it matches our local African recipe database first
    if (localAfricanRecipes[query]) {
        displayRecipeDetails(localAfricanRecipes[query]);
        return;
    }

    // Check partial matches in local database (e.g. typing "banku" or "jollof")
    for (let key in localAfricanRecipes) {
        if (key.includes(query) || query.includes(key)) {
            displayRecipeDetails(localAfricanRecipes[key]);
            return;
        }
    }

    // 2. Otherwise, look up options from TheMealDB online API
    const apiUrl = `https://www.themealdb.com/api/json/v1/1/search.php?s=${query}`;

    try {
        const response = await fetch(apiUrl);
        const data = await response.json();

        if (data.meals && data.meals.length > 0) {
            // If there are multiple matches (e.g. typing "rice"), create option buttons for user to choose
            if (data.meals.length > 1) {
                document.getElementById("recipe-title").innerText = "Multiple Options Found";
                document.getElementById("recipe-desc").innerText = "We found multiple dishes matching your search. Click one below:";
                
                data.meals.forEach(meal => {
                    const btn = document.createElement("button");
                    btn.className = "option-btn";
                    btn.innerText = meal.strMeal;
                    btn.onclick = () => {
                        formatAndDisplayApiMeal(meal);
                        optionsContainer.innerHTML = ""; // Clear buttons after selection
                    };
                    optionsContainer.appendChild(btn);
                });
            } else {
                formatAndDisplayApiMeal(data.meals[0]);
            }
        } else {
            document.getElementById("recipe-title").innerText = "Recipe Not Found";
            document.getElementById("recipe-desc").innerText = `We couldn't find "${query}". Try searching for jollof, banku, fufu, or chicken!`;
            document.getElementById("recipe-image").src = "https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=600&auto=format&fit=crop&q=60";
            document.getElementById("ingredients-list").innerHTML = "<li>None</li>";
            document.getElementById("steps-container").innerHTML = "<p><em>No steps available.</em></p>";
        }
    } catch (error) {
        console.error("Error fetching recipe:", error);
        alert("Failed to connect to the recipe database. Please check your internet connection.");
    }
}

// Display custom structured local/selected recipe details
function displayRecipeDetails(recipe) {
    document.getElementById("recipe-title").innerText = recipe.title;
    document.getElementById("recipe-desc").innerText = recipe.description;
    document.getElementById("recipe-image").src = recipe.image;

    // Utensils
    const utensilsList = document.getElementById("utensils-list");
    utensilsList.innerHTML = "";
    recipe.utensils.forEach(u => {
        const li = document.createElement("li");
        li.innerText = u;
        utensilsList.appendChild(li);
    });

    // Ingredients
    const ingredientsList = document.getElementById("ingredients-list");
    ingredientsList.innerHTML = "";
    recipe.ingredients.forEach(i => {
        const li = document.createElement("li");
        li.innerText = i;
        ingredientsList.appendChild(li);
    });

    // Steps with visual images
    const stepsContainer = document.getElementById("steps-container");
    stepsContainer.innerHTML = "";
    recipe.steps.forEach(stepObj => {
        const div = document.createElement("div");
        div.className = "step-card";
        div.innerHTML = `
            <img src="${stepObj.img}" alt="Step image" class="step-img">
            <p>${stepObj.text}</p>
        `;
        stepsContainer.appendChild(div);
    });
}

// Helper to format API results into step images
function formatAndDisplayApiMeal(meal) {
    const ingredients = [];
    for (let i = 1; i <= 20; i++) {
        const ing = meal[`strIngredient${i}`];
        const measure = meal[`strMeasure${i}`];
        if (ing && ing.trim() !== "") {
            ingredients.push(`${measure ? measure : ""} ${ing}`.trim());
        }
    }

    const rawSteps = meal.strInstructions.split(/\r?\n/).filter(s => s.trim() !== "");
    const steps = rawSteps.map(text => ({
        text: text,
        img: meal.strMealThumb // Fallback step picture representation
    }));

    displayRecipeDetails({
        title: meal.strMeal,
        image: meal.strMealThumb,
        description: `Category: ${meal.strCategory} | Origin: ${meal.strArea}`,
        utensils: ["Standard kitchen knives", "Cutting board", "Cooking pans"],
        ingredients: ingredients,
        steps: steps
    });
}
